  },
  "keywords": [
    "solana",
    "ed25519",
    "agent",
    "ai-agent",
    "post-quantum",
    "self-custody",
    "cross-chain"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexus-genesis/aegis-vault.git",
    "directory": "packages/chain-sol"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
