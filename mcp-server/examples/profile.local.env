# Aegis Vault Deployment Profile — local (开发/测试)
#
# 内建三档 profile 之一。local 允许著名的 anvil 默认私钥 + 进程内 LocalChain
# （仅当显式 CHAIN_ALLOW_LOCAL=1）。本文件供参考；实际注入后用 CHAIN_PROFILE=
# local 显式声明（生产绝不使用）。
CHAIN_PROFILE=local

# local 不强制要求外部 RPC —— 缺省走进程内 LocalChain（CHAIN_ALLOW_LOCAL=1）。
CHAIN_ALLOW_LOCAL=1

# 日志（可选）：落盘 + 体积上限滚动。
AUDIT_LOG_FILE=./data/audit-local.jsonl
AUDIT_LOG_MAX_BYTES=10485760