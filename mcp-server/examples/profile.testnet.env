# Aegis Vault Deployment Profile — testnet (显式 RPC，禁 anvil 默认键)
#
# 内建三档 profile 之一。testnet 强制要求显式外部 RPC + relayer 广播私钥，
# 且拒不接受众所周知的 anvil 测试私钥。本示例用占位符 —— 部署前替换为真实值。
CHAIN_PROFILE=testnet
CHAIN_RPC_URL=https://sepolia.infura.io/v3/REPLACE_WITH_REAL
CHAIN_OWNER_PK=REPLACE_WITH_REAL_OWNER
CHAIN_EMERGENCY_PK=REPLACE_WITH_REAL_EMERGENCY
CHAIN_RELAYER_PK=REPLACE_WITH_REAL_RELAYER

# 状态后端（可选）：testnet 建议显式 SQLite 共享，便于对账/去重。
NEXUS_STORE_BACKEND=sqlite
SMART_ACCOUNT_STATE_FILE=./data/state-testnet.json
SIMULATION_LOG_FILE=./data/sim-testnet.json

# 可观测：显式指标/健康端口（可选开启，独立 loopback 端口）。
METRICS_HTTP_PORT=9091
HEALTH_HTTP_PORT=9092

# 审计落盘 + 体积滚动。
AUDIT_LOG_FILE=./data/audit-testnet.jsonl
AUDIT_LOG_MAX_BYTES=10485760