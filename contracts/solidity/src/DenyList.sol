    /// @return true when `h` (keccak256 of a normalized string) is a isAllowanceSurface action.
    function isAllowanceSurface(bytes32 h) internal pure returns (bool) {
        if (
            h == keccak256("approve") ||
            h == keccak256("approveandcall") ||
            h == keccak256("createallowance") ||
            h == keccak256("increaseallowance") ||
            h == keccak256("increaseapproval") ||
            h == keccak256("permit") ||
            h == keccak256("permit2") ||
            h == keccak256("setapprovalforall") ||
            h == keccak256("transferfrom")
        ) return true;
        return false;
    }
